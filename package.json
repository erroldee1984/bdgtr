{
  "name": "bdgtr",
  "private": true,
  "description": "Household budgeting and expense tracker (Android + web)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:api": "pnpm --filter @bdgtr/api dev",
    "dev:mobile": "pnpm --filter @bdgtr/mobile start",
    "build:web": "pnpm --filter @bdgtr/mobile build:web",
    "dev:web": "pnpm --filter @bdgtr/mobile dev:web",
    "dev:phone": "node scripts/dev-phone.mjs"
  },
  "packageManager": "pnpm@12.21.0"
}
