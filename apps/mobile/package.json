{
  "name": "@bdgtr/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bdgtr/shared": "workspace:*",
    "@clerk/expo": "^4.17.4",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.1.0",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.23",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@expo/fingerprint": "~0.22.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "pnpm --filter @bdgtr/shared build && expo start",
    "android": "pnpm --filter @bdgtr/shared build && expo start --android",
    "web": "pnpm --filter @bdgtr/shared build && expo start --web",
    "build:web": "pnpm --filter @bdgtr/shared build && expo export -p web && node scripts/write-web-headers.mjs dist",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @bdgtr/shared build && expo start --web",
    "dev:phone": "node ../../scripts/dev-phone.mjs",
    "test:a11y": "playwright test"
  },
  "private": true,
  "description": "bdgtr app for Android and web (Expo / React Native)",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testTimeout": 20000,
    "maxWorkers": 4,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 80,
        "functions": 75,
        "lines": 85
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?[/+].*|@expo-google-fonts[/+].*|react-navigation|@react-navigation[/+].*|@sentry[/+]react-native|native-base|react-native-svg|standard-navigation|@bdgtr[/+].*|@noble[/+].*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
