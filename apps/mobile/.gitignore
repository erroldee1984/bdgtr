# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Firebase (Android push): config comes from the EAS GOOGLE_SERVICES_JSON file variable;
# the FCM service-account key is uploaded to EAS and must never be committed.
google-services.json
*firebase-adminsdk*.json

# Playwright (e2e/a11y) output
test-results/
playwright-report/

# EAS keystore download (passwords): never commit
credentials.json
credentials/
