# Copy to `.env.local` (git-ignored). Values here are PUBLIC: they are baked into
# the app and anyone can read them. Never put secrets in EXPO_PUBLIC_* variables.

# Where the app finds the bdgtr API.
#  - web on this machine:   http://localhost:8787
#  - Android emulator:      http://10.0.2.2:8787  (the emulator's alias for your PC)
#  - production:            https://bdgtr-api.erroldee.com
EXPO_PUBLIC_API_URL=http://localhost:8787
