{
  "expo": {
    "name": "bdgtr",
    "slug": "bdgtr",
    "version": "0.1.0",
    "description": "Household budgeting and expense tracker",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bdgtr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12152B",
    "android": {
      "package": "com.erroldee.bdgtr",
      "adaptiveIcon": {
        "backgroundColor": "#161A31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bdgtr.erroldee.com",
              "pathPrefix": "/invite/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "name": "bdgtr",
      "shortName": "bdgtr",
      "lang": "en-PH",
      "themeColor": "#12152B",
      "backgroundColor": "#12152B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12152B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@clerk/expo",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5A94FF",
          "defaultChannel": "budget-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "29a02e74-ba1c-421f-8a84-f5a96f49a871"
      }
    },
    "owner": "erroldee1984"
  }
}
