{
  "expo": {
    "name": "bdgtr",
    "slug": "bdgtr",
    "version": "0.1.0",
    "description": "Household budgeting and expense tracker",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bdgtr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12152B",
    "android": {
      "package": "com.erroldee.bdgtr",
      "adaptiveIcon": {
        "backgroundColor": "#12152B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "bdgtr",
      "shortName": "bdgtr",
      "lang": "en-PH",
      "themeColor": "#12152B",
      "backgroundColor": "#12152B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12152B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
