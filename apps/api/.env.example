# Copy this file to `.env` (which git ignores) and fill in real values.
# NEVER commit `.env` or paste its contents anywhere. See docs/PLAN.md §10.

# MongoDB Atlas connection string (Atlas → Connect → Drivers → Node.js).
# Replace <db_password> with the database user's password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=bdgtr-cluster

# Database name (the Atlas user only has readWrite on this one)
MONGODB_DB=bdgtr

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8081,https://bdgtr.erroldee.com

# Local dev port
PORT=8787
