# Copy this file to `.env` (which git ignores) and fill in real values.
# NEVER commit `.env` or paste its contents anywhere. See docs/PLAN.md §10.

# MongoDB Atlas connection string (Atlas → Connect → Drivers → Node.js).
# Replace <db_password> with the database user's password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=bdgtr-cluster

# Database name. Use bdgtr_dev locally so testing never touches real data;
# production (Vercel) uses bdgtr. The Atlas user needs readWrite on both.
MONGODB_DB=bdgtr_dev

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8081,https://bdgtr.erroldee.com

# Local dev port
PORT=8787

# Clerk instance JWT public key (Clerk dashboard → Configure → API keys →
# "JWT public key" → PEM). It's a PUBLIC key, not a secret. Use the
# DEVELOPMENT instance's key locally and the PRODUCTION instance's key on Vercel.
# Paste it on one line with \n between the lines, inside double quotes:
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----"
CLERK_JWT_KEY=
