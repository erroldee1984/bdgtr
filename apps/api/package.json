{
  "name": "@bdgtr/api",
  "version": "0.1.0",
  "private": true,
  "description": "bdgtr HTTP API (Hono). Holds all secrets; the apps never talk to MongoDB directly.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bdgtr/shared build && tsx watch src/server.ts",
    "start": "pnpm --filter @bdgtr/shared build && tsx src/server.ts",
    "test": "pnpm --filter @bdgtr/shared build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:deploy": "pnpm --filter @bdgtr/shared build && node scripts/verify-deploy-build.mjs"
  },
  "dependencies": {
    "@bdgtr/shared": "workspace:*",
    "@clerk/backend": "^3.31.4",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.20",
    "mongodb": "^7.9.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.1.1",
    "mongodb-memory-server": "^11.4.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "26.x"
  }
}
