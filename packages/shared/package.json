{
  "name": "@bdgtr/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Pure business logic, schemas and formatting shared by the app and the API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
